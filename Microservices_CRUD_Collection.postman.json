        {
          "name": "Create Startup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tech Innovation Lab\",\n  \"foundedAt\": \"2024-01-15\",\n  \"location\": \"Mexico City, MX\",\n  \"category\": \"AI/ML\",\n  \"fundingAmount\": 2500000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/startups",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "startups"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"JSON response\", () => pm.response.to.be.json);",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"startupId\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
