    {
      "name": "Health Checks",
      "item": [
        {
          "name": "Gateway Health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{gatewayUrl}}/status",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "status"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON response\", () => pm.response.to.be.json);",
                  "pm.test(\"Gateway is healthy\", () => pm.expect(pm.response.json()).to.eql({status: \"healthy\", service: \"api-gateway\"}));"
                ]
              }
            }
          ]
        }
      ]
